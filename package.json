{
  "name": "web-spice",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web circuit simulator: spicekit (SPICE-class engine, protocol, client, server, CLI) + circuit-studio (schematic editor & instruments).",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "spicekit/packages/*",
    "circuit-studio"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:eslint": "eslint .",
    "format": "biome format --write .",
    "test": "bun test spicekit",
    "test:coverage": "bun test spicekit --coverage",
    "test:conformance": "bun test spicekit/packages/client/test",
    "dev": "bun run --filter circuit-studio dev",
    "build:studio": "bun run --filter circuit-studio build",
    "check:deps": "depcruise spicekit/packages circuit-studio/src --config .dependency-cruiser.cjs",
    "doctor": "bun spicekit/scripts/doctor.ts",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "hooks:install": "lefthook install",
    "check": "bun run lint && bun run lint:eslint && bun run typecheck && bun run test && bun run check:deps"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.5.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.36.0",
    "knip": "^5.63.0",
    "lefthook": "^1.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "trustedDependencies": []
}
